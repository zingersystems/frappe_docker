#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
	echo "Usage: switch-environment {develop|staging|main}" >&2
	exit 2
fi

target=$1
case "$target" in
	develop|staging|main) ;;
	*) echo "Unknown environment: $target" >&2; exit 2 ;;
esac

workspace=${PROJECT_ROOT:-/workspace}
bench_root=${BENCH_ROOT:-$workspace/development/frappe-bench}
site_name=${SITE_NAME:-academia-frappe-catuc}
backup_root=${BACKUP_ROOT:-/srv/backups}
state_file="$workspace/development/.runtime-environment"
lock_dir="$workspace/development/.runtime-lock"
bench_hold_file="$workspace/development/.bench-start.hold"
bench_pid_file="$workspace/development/.bench-start.pid"
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
manifest="$workspace/development/deployment/catuc/manifests/$target.json"

mkdir "$lock_dir" 2>/dev/null || { echo "Runtime is owned by another developer or operation" >&2; exit 1; }
maintenance_enabled=false
bench_held=false
release_bench() {
	rm -f "$bench_hold_file"
	bench_held=false
}
cleanup() {
	if [ "$bench_held" = true ]; then
		release_bench
	fi
	if [ "$maintenance_enabled" = true ]; then
		bench --site "$site_name" set-maintenance-mode off >/dev/null 2>&1 || true
	fi
	rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT

current=develop
if [ -f "$state_file" ]; then
	current=$(tr -d '\r\n' < "$state_file")
fi

bench --site "$site_name" set-maintenance-mode on
maintenance_enabled=true
"$script_dir/backup-site" "branches/$current"

touch "$bench_hold_file"
bench_held=true
if [ -s "$bench_pid_file" ]; then
	bench_pid=$(tr -d '\r\n' < "$bench_pid_file")
	case "$bench_pid" in
		*[!0-9]*|"") echo "Invalid Bench PID: $bench_pid" >&2; exit 1 ;;
	esac
	kill -TERM "$bench_pid"
	for _ in $(seq 1 30); do
		kill -0 "$bench_pid" 2>/dev/null || break
		sleep 1
	done
	if kill -0 "$bench_pid" 2>/dev/null; then
		echo "Bench did not stop within 30 seconds" >&2
		exit 1
	fi
fi

repositories=(
	"$workspace"
	"$bench_root/apps/academia_core"
	"$bench_root/apps/academia_catuc"
	"$bench_root/apps/frappe_pay_connect"
)
for repository in "${repositories[@]}"; do
	if [ -n "$(git -C "$repository" status --porcelain)" ]; then
		echo "Refusing switch: changes remain in $repository" >&2
		exit 1
	fi
	git -C "$repository" fetch origin "$target"
	git -C "$repository" switch "$target"
	git -C "$repository" merge --ff-only "origin/$target"
done

while read -r app expected; do
	app_repository="$bench_root/apps/$app"
	actual=$(git -C "$app_repository" rev-parse HEAD)
	case "$actual" in
		"$expected"*) ;;
		*) echo "Manifest mismatch for $app: expected $expected, found $actual" >&2; exit 1 ;;
	esac
done < <(python -c 'import json,sys; data=json.load(open(sys.argv[1])); [print(k, v) for k,v in data["apps"].items()]' "$manifest")

snapshot=$(find "$backup_root/branches/$target" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -nr | sed -n '1s/^[^ ]* //p')
if [ -z "$snapshot" ]; then
	echo "No database snapshot exists for $target" >&2
	exit 1
fi

"$script_dir/restore-site" "$snapshot"
printf '%s\n' "$target" > "$state_file"
bench build --app academia_core --app academia_catuc --app frappe_pay_connect
bench --site "$site_name" clear-cache
release_bench

healthy=false
for _ in $(seq 1 60); do
	if curl --fail --silent --output /dev/null -H "Host: academia-frappe-catuc.localhost" http://127.0.0.1:8000/; then
		healthy=true
		break
	fi
	sleep 1
done
if [ "$healthy" != true ]; then
	echo "Bench failed its internal HTTP health check" >&2
	exit 1
fi

bench --site "$site_name" set-maintenance-mode off
maintenance_enabled=false
